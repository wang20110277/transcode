{
  "name": "@trans-ai/trans-code",
  "version": "0.8.1",
  "description": "AI-powered multi-model coding CLI",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wang20110277/transcode.git"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md"
  ],
  "bin": {
    "transcode": "./bin/transcode.ts"
  },
  "scripts": {
    "build:repl": "bun build src/main.tsx --target=node --packages=external --outdir=dist",
    "start": "bun run build:repl && node dist/main.js",
    "dev": "bun run build:repl && node dist/main.js",
    "acp": "bun bin/transcode.ts acp",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:acp": "bun scripts/acp-smoke.ts",
    "test:acp:openai": "bun scripts/acp-openai-smoke.ts",
    "test:acp:real": "bun scripts/acp-real-smoke.ts",
    "model:check": "bun scripts/model-check.ts",
    "version": "bun scripts/sync-version.ts"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.4.0",
    "@langchain/anthropic": "^0.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.7.0"
  }
}
